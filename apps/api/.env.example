# Optional in demo mode. Set DATA_SOURCE=postgres for database-backed API.
DATABASE_URL=postgres://crime:crime_local_only@127.0.0.1:54329/crime_radar
DATA_SOURCE=mock
# In postgres mode, real records are the default; use demo to query only the seed.
DATA_SET=real
API_PORT=3000
API_HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NODE_ENV=development
# Optional future provider settings; the current collector uses an offline city gazetteer.
GEOCODING_PROVIDER=
GEOCODING_API_KEY=
AI_PROVIDER=
AI_API_KEY=
